{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!skills/**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": { "level": "on", "options": { "style": "separatedType" } },
        "useExportType": { "level": "on", "options": { "style": "separatedType" } }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": true,
            "groups": [
              { "type": true },
              ":BLANK_LINE:",
              { "kind": "bare" },
              ":BLANK_LINE:",
              { "source": [":BUN:", ":NODE:"] },
              ":BLANK_LINE:",
              { "source": [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"] },
              ":BLANK_LINE:",
              { "source": ":ALIAS:" },
              ":BLANK_LINE:",
              { "source": "../**" },
              ":BLANK_LINE:",
              { "source": "./**" },
              { "source": [":PATH:", ":URL:"] }
            ]
          }
        }
      }
    }
  }
}
